{
  "compilerOptions": {
    "target": "es2020",                                 // transpilyatsiya qilinadigan JS versiyasi
    "module": "commonjs",                               // modul turi (Node.js uchun commonjs)
    "rootDir": "./src",                                 // manba kod joylashgan papka
    "outDir": "./dist",                                 // transpilyatsiya qilingan kod chiqadigan pap
    "strict": true,                                     // qat'iy tekshiruvlarni yoqish
    "esModuleInterop": true,                            // import/export bilan moslashuvchanlik
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],                                   // qaysi fayllani o'qishi
  "exclude": ["node_modules", "dist"]                   // qaysilarini oqimastan tashab ketishi
}